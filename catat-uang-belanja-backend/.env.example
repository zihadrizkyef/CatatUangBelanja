PORT=3000
DATABASE_URL="postgresql://user:password@localhost:5432/catat_uang_belanja"
JWT_SECRET="replace-with-a-long-random-string"
# Web OAuth Client ID from Google Cloud Console — also used as the Android
# app's serverClientId. See README for setup steps.
GOOGLE_CLIENT_ID=""
# Same OAuth client's secret — only needed for the Bank Jago Gmail sync
# (integrasi-jago), which exchanges a serverAuthCode for tokens (a
# confidential-client operation, unlike the secret-free ID-token
# verification /auth/google already does).
GOOGLE_CLIENT_SECRET=""
# 32 random bytes, base64-encoded (e.g. `openssl rand -base64 32`) — AES key
# used to encrypt the Jago Gmail refresh token at rest.
TOKEN_ENCRYPTION_KEY=""
# Bank Jago's notification sender domain — confirmed from a real email
# (`From: "Jago" <noreply@jago.com>`). Overriding this needs no redeploy,
# just this env var — e.g. if Jago sends other notification types from a
# different address.
JAGO_SENDER_EMAIL="jago.com"
