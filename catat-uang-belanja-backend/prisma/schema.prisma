// Mirrors the entities in "Draft Aplikasi Pencatatan Keuangan" section 5.
// Used for Tahap 4 (online sync) — not required by the offline MVP.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum WalletType {
  Cash
  Bank
  EWallet
  Savings
  Other
}

enum IconType {
  System
  Emoji
  Photo
}

enum CategoryType {
  Income
  Expense
}

enum TransactionType {
  Income
  Expense
  Transfer
}

enum SyncStatus {
  Synced
  Pending
  Failed
}

enum BudgetPeriod {
  Monthly
  Weekly
  Event
}

enum Frequency {
  Daily
  Weekly
  Monthly
}

enum Theme {
  Light
  Dark
  System
}

enum AppLockType {
  PIN
  Biometric
  None
}

// Not part of the Flutter model — server-only, marks which Transaction rows
// were created by the Bank Jago email sync vs. entered by hand.
enum TransactionSource {
  Manual
  EmailSync
}

// Login is Google Sign-In (no password / OTP stored) — see doc 4.10 / 6.1.
model User {
  id                 String               @id @default(uuid())
  googleId           String               @unique
  email              String               @unique
  name               String
  avatarUrl          String?
  createdAt          DateTime             @default(now())
  wallets            Wallet[]
  categories         Category[]
  transactions       Transaction[]
  budgets            Budget[]
  recurringTxns      RecurringTransaction[]
  settings           Settings?

  // Bank Jago email sync (integrasi-jago) — all null/unset until the user
  // connects it from Settings. jagoRefreshToken is AES-encrypted at rest
  // (see lib/googleOAuth.ts), never returned to any client. Which Jago
  // Kantong maps to which Wallet lives in JagoKantong below, not here —
  // a user has one Kantong Terhubung plus zero or more named pockets,
  // each becoming its own Wallet (see lib/jagoSync.ts).
  jagoRefreshToken   String?
  jagoHistoryId      String?
  jagoConnectedAt    DateTime?
  jagoKantongs       JagoKantong[]
}

model Wallet {
  id          String     @id @default(uuid())
  user        User       @relation(fields: [userId], references: [id])
  userId      String
  name        String
  type        WalletType
  color       String
  iconType    IconType
  iconValue   String
  isArchived  Boolean    @default(false)
  createdAt   DateTime   @default(now())
  // Not part of the Flutter model (doc 5.1) — server-managed, used only as
  // the pull-sync cursor (see /sync/pull).
  updatedAt   DateTime   @updatedAt

  transactionsFrom Transaction[] @relation("WalletSource")
  transactionsTo   Transaction[] @relation("WalletTarget")
  jagoKantongs     JagoKantong[]

  @@index([userId])
}

// Maps one Bank Jago Kantong (pocket) to the Wallet auto-created for it —
// see lib/jagoSync.ts's resolveKantongWallet. Jago's own notification
// emails expose two disjoint identifier spaces that can't be reconciled
// automatically (see jagoParser.ts's header comment): the single Kantong
// Terhubung is only ever identified by an account number, everything else
// only by a Kantong name — so `key` is either the CONNECTED_KANTONG_KEY
// sentinel or a lowercased/trimmed Kantong name, never an account number.
model JagoKantong {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  key       String
  wallet    Wallet   @relation(fields: [walletId], references: [id])
  walletId  String
  createdAt DateTime @default(now())

  @@unique([userId, key])
}

model Category {
  id           String        @id @default(uuid())
  user         User?         @relation(fields: [userId], references: [id])
  userId       String?
  name         String
  type         CategoryType
  color        String
  iconType     IconType
  iconValue    String
  isSystem     Boolean       @default(false)
  // Not part of the Flutter model (doc 5.3) — server-managed, used only as
  // the pull-sync cursor (see /sync/pull).
  updatedAt    DateTime      @updatedAt
  transactions Transaction[]
  budgets      Budget[]

  @@index([userId])
}

model Transaction {
  id              String          @id @default(uuid())
  user            User            @relation(fields: [userId], references: [id])
  userId          String
  type            TransactionType
  amount          Int
  wallet          Wallet          @relation("WalletSource", fields: [walletId], references: [id])
  walletId        String
  targetWallet    Wallet?         @relation("WalletTarget", fields: [targetWalletId], references: [id])
  targetWalletId  String?
  category        Category?       @relation(fields: [categoryId], references: [id])
  categoryId      String?
  dateTime        DateTime
  note            String?
  attachmentUrl   String?
  recurring       RecurringTransaction? @relation(fields: [recurringId], references: [id])
  recurringId     String?
  isDeleted       Boolean         @default(false)
  syncStatus      SyncStatus      @default(Synced)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  // Not part of the Flutter model's write path (doc 5.2) — server-set,
  // pulled down read-only. source distinguishes Bank Jago email-sync rows
  // from hand-entered ones; externalId is the Gmail message id, used as
  // the dedupe key so re-running the sync never double-inserts.
  source          TransactionSource @default(Manual)
  externalId      String?         @unique

  @@index([userId])
  @@index([walletId])
}

model Budget {
  id                     String       @id @default(uuid())
  user                   User         @relation(fields: [userId], references: [id])
  userId                 String
  category               Category     @relation(fields: [categoryId], references: [id])
  categoryId             String
  period                 BudgetPeriod @default(Monthly)
  // Day-of-month (1-31) or day-of-week when period = Monthly/Weekly; null for Event.
  resetAnchor            Int?
  // Income category that triggers a reset when period = Event; null otherwise.
  triggerCategoryId      String?
  limitAmount            Int
  currentPeriodStartedAt DateTime
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  @@index([userId])
}

model RecurringTransaction {
  id           String        @id @default(uuid())
  user         User          @relation(fields: [userId], references: [id])
  userId       String
  type         TransactionType
  amount       Int
  walletId     String
  categoryId   String
  frequency    Frequency
  startDate    DateTime
  nextRunAt    DateTime
  isActive     Boolean       @default(true)
  note         String?
  // Not part of the Flutter model — server-managed, used only as the
  // pull-sync cursor (see /sync/pull).
  updatedAt    DateTime      @updatedAt
  transactions Transaction[]

  @@index([userId])
}

model Settings {
  id               String      @id @default(uuid())
  user             User        @relation(fields: [userId], references: [id])
  userId           String      @unique
  theme            Theme       @default(System)
  backgroundTheme  String?
  appLockEnabled   Boolean     @default(false)
  appLockType      AppLockType @default(None)
  lastSyncedAt     DateTime?
  updatedAt        DateTime    @updatedAt
}
